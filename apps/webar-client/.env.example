# Shared/hosted service URLs used at build time.
VITE_ASSET_API_URL=https://<backend-host>/asset/api/v1
VITE_MONITORING_API_URL=https://<backend-host>/monitoring/api/v1
VITE_MONITORING_SOCKET_URL=https://<backend-host>

# Optional fallback endpoint used by the existing mock flow.
VITE_ASSET_CONTEXT_API_URL=/mock-api/nodes

# MindAR target assets.
VITE_MINDAR_IMAGE_TARGET_SRC=/targets/card-example/card.mind
VITE_MINDAR_TARGET_IMAGE_SRC=/targets/card-example/card.png
