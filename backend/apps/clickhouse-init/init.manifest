-- =========================================================

SOURCE './06_rack_serving/01_rack_current_summary.sql';

SOURCE './06_rack_serving/02_rack_summary_trend_1m.sql';

SOURCE './06_rack_serving/03_rack_summary_trend_5m.sql';

