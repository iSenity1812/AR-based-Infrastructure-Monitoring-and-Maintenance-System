{
  "name": "@ar-monitoring/ar-bff-service",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "start": "node dist/control-plane/ar-bff-service/src/main.js",
    "prestart": "pnpm build",
    "start:dev": "ts-node -r tsconfig-paths/register --transpile-only src/main.ts",
    "start:prod": "node dist/control-plane/ar-bff-service/src/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --runInBand",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@nestjs/common": "11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "11",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.4",
    "@sjfrhafe/nest-problem-details": "^1.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
