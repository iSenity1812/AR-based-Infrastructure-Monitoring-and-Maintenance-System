NODE_ENV=development
PORT=4002
ASSET_GRPC_HOST=0.0.0.0
ASSET_GRPC_PORT=50052
ASSET_MONGODB_URI=mongodb://127.0.0.1:27017/asset_db
ASSET_REDIS_URL=redis://127.0.0.1:6379/0
MONGODB_URI=
JWT_ACCESS_SECRET=change-me-access-secret
ACCESS_TOKEN_SECRET=dev-access-token-secret
SWAGGER_ENABLED=true
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_RETRY_ATTEMPTS=1
MONGODB_RETRY_DELAY_MS=1000
ASSET_KAFKA_BROKERS=localhost:19092
ASSET_KAFKA_CLIENT_ID=asset-service
ASSET_NODE_MAPPING_TOPIC=asset.node.mapping
CORS_ORIGINS=http://localhost:4002,http://localhost:3000
CORS_ENABLED=true
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
API_PREFIX=api/v1
