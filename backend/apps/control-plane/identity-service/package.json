{
  "name": "@ar-monitoring/identity-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "dev": "ts-node -r tsconfig-paths/register src/infrastructure/bootstrap/main.ts",
    "start": "node dist/infrastructure/bootstrap/main.js",
    "prestart": "pnpm build",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "jest --runInBand",
    "seed": "ts-node -r tsconfig-paths/register src/infrastructure/bootstrap/seed.ts",
    "migrate:create": "migrate-mongo create -f ./migrate-mongo-config.js",
    "migrate:status": "migrate-mongo status -f ./migrate-mongo-config.js",
    "migrate:up": "migrate-mongo up -f ./migrate-mongo-config.js",
    "migrate:down": "migrate-mongo down -f ./migrate-mongo-config.js"
  },
  "dependencies": {
    "@nestjs/common": "10",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "10",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "migrate-mongo": "^14.0.7",
    "mongoose": "^8.17.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.7",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "10",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.21",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "supertest": "^7.1.1",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
