PORT=4003
API_PREFIX=api/v1
PUBLIC_API_BASE_PATH=/monitoring
CORS_ORIGIN=*
NODE_ENV=production
JWT_ACCESS_SECRET=change-me-access-secret
MONITORING_MONGODB_URI=mongodb://host.docker.internal:27017/monitoring_db
REDIS_URL=redis://host.docker.internal:6379/0
ACCESS_TOKEN_SECRET=dev-access-token-secret
SWAGGER_ENABLED=true
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_RETRY_ATTEMPTS=1
MONGO_RETRY_DELAY_MS=1000
MONGO_LAZY_CONNECTION=true
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=root
CLICKHOUSE_PASSWORD=password
CLICKHOUSE_DATABASE=telemetry_db
CLICKHOUSE_APPLICATION=monitoring-service
CLICKHOUSE_REQUEST_TIMEOUT_MS=30000
ALERTMANAGER_ENABLED=true
ALERTMANAGER_BASE_URL=http://alertmanager:9093
ALERTMANAGER_TIMEOUT_MS=5000
MONITORING_ALERT_SYNC_SHARED_SECRET=change-me-monitoring-sync-secret
MONITORING_RACK_POLL_ENABLED=true
MONITORING_RACK_POLL_INTERVAL_MS=30000
ASSET_SERVICE_GRPC_HOST=asset-service
ASSET_SERVICE_GRPC_PORT=50052
