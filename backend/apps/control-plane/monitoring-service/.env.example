PORT=4003
API_PREFIX=api/v1
CORS_ORIGIN=*
NODE_ENV=development
JWT_ACCESS_SECRET=change-me-access-secret
MONITORING_MONGODB_URI=mongodb://127.0.0.1:27017/monitoring_db
REDIS_URL=redis://127.0.0.1:6379/0
ACCESS_TOKEN_SECRET=dev-access-token-secret
SWAGGER_ENABLED=true
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_RETRY_ATTEMPTS=1
MONGO_RETRY_DELAY_MS=1000
MONGO_LAZY_CONNECTION=true
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=root
CLICKHOUSE_PASSWORD=password
CLICKHOUSE_DATABASE=telemetry_db
CLICKHOUSE_APPLICATION=monitoring-service
CLICKHOUSE_REQUEST_TIMEOUT_MS=30000
ASSET_SERVICE_GRPC_HOST=127.0.0.1
ASSET_SERVICE_GRPC_PORT=50052
