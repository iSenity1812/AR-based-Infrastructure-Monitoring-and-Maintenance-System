{
  "expo": {
    "name": "AR-IMMS Field",
    "slug": "ar-imms-field",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "arimms",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07111f"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image-picker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AR-IMMS Field to scan Rack and Node QR codes"
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "identityApiUrl": "http://localhost:4001/api/v1",
      "incidentApiUrl": "http://localhost:4004/api/v1"
    }
  }
}
