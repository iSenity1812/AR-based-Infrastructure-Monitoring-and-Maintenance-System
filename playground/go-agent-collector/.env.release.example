# Optional override when you want runtime files outside the collector folder.
GO_AGENT_BASE_DIR=

# Registration bootstrap
GO_AGENT_BOOTSTRAP_TOKEN=
GO_AGENT_REGISTRATION_ENDPOINT=127.0.0.1:8443
GO_AGENT_REGISTRATION_SERVER_NAME=local-ingestion.local

# Set one of these when you do not want to use the bundled CA cert.
GO_AGENT_REGISTRATION_CA_CERT_PATH=
GO_AGENT_REGISTRATION_CA_CERT_PEM=

# Optional client credential overrides when certificates are provisioned externally.
GO_AGENT_REGISTRATION_CLIENT_CERT_PATH=
GO_AGENT_REGISTRATION_CLIENT_KEY_PATH=
GO_AGENT_REGISTRATION_STATE_PATH=
GO_AGENT_REGISTRATION_SHARED_CONFIG_PATH=

# Optional runtime identity overrides.
GO_AGENT_ID=
GO_AGENT_NAME=
GO_NODE_ID=
GO_NODE_NAME=
GO_PRIMARY_NIC=

# Optional send auth token for HTTP delivery mode.
GO_AGENT_API_TOKEN=
